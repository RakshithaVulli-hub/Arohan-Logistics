{
  "name": "micro-cold-chain-server",
  "version": "1.0.0",
  "description": "Express + MongoDB backend for Micro Cold Chain Supply Logistics",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx seed.ts",
    "seed:clear": "tsx seed.ts --clear",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "mongoose": "^8.24.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5"
  }
}
